    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "dat1 = [1, 2, 3]\n",
        "dat2 = dat1\n",
        "dat1[0] = 100\n",
        "print(dat1)\n",
        "print(dat2)\n",
        "\n",
        "x = 1\n",
        "y = x\n",
        "print(id(x))\n",
        "print(id(y))\n",
        "x += 10\n",
        "print(x)\n",
        "print(y)\n",
        "\n",
